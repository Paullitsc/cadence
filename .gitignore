# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
build/
dist/

# Env / secrets
.env
.env.*
!.env.example
*.local
# Gmail OAuth (Phase 3): client-secrets + minted token. Unanchored on purpose —
# daily.yml materializes gmail_token.json at the repo ROOT, not under data/.
*token*.json
*credentials*.json
# Google service-account key (Phase 5 tracker) — never commit it
*service_account*.json
cadence-*.json
# Belt-and-braces: any key material, wherever it lands.
*.pem
*.p12
*.pfx
*.key

# Data / runtime artifacts
data/*.db
data/*.sqlite3
data/digests/
data/resumes/
rendercv_output/
*.log

# Personal résumé content — real name/contact/experience (PII). Only the
# .example.yaml templates (placeholder data) are tracked.
/master_resume.yaml
/Paul_CV.yaml
/Resume.tex
*_CV.yaml
*_cv.yaml
/*.pdf
/*.docx

# Networking roster — real third-party names + LinkedIn URLs. The repo is public,
# so this is materialized in CI from the NETWORKING_TARGETS_YAML secret instead of
# being tracked (same pattern as master_resume.yaml). Your local copy is the
# master: edit it, then `make roster-push` to refresh the secret.
# NOTE: versions committed before 2026-07-28 remain in this repo's git history.
/networking_targets.yaml

# OS / editor
.DS_Store
.idea/
.vscode/

# Local-only planning/reference docs (not part of the repo)
/ACTIONS_FOR_PAUL.md
/Automated Intern Recruitment Workflow.md
/CLAUDE.md
/assignment.md